{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@ui/*": ["../../packages/ui/src/*"],
      "@modules/*": ["../../modules/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../modules/*/src/**/*.ts",
    "../../modules/*/src/**/*.tsx",
    "../../packages/*/src/**/*.ts",
    "../../packages/*/src/**/*.tsx"
  ]
}

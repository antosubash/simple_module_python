{
  "name": "simple-module-python",
  "private": true,
  "workspaces": [
    "host/client_app",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "dev": "npm run --workspace host/client_app dev",
    "build": "npm run --workspace host/client_app build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "uv run --project host smpy host typecheck --host-dir=host/client_app",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@biomejs/biome": "^2.6.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^30.1.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "vite": "$vite",
    "postcss-selector-parser": "^6.1.5"
  }
}

{
  "name": "@simple-module-py/ui",
  "version": "0.0.11",
  "description": "shadcn-derived React UI components and layouts for simple_module apps",
  "keywords": [
    "simple-module",
    "react",
    "shadcn",
    "tailwind",
    "ui"
  ],
  "homepage": "https://github.com/antosubash/simple_module_python#readme",
  "bugs": "https://github.com/antosubash/simple_module_python/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antosubash/simple_module_python.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "author": "Anto Subash <antosubash@live.com>",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/ui/*": {
      "types": "./src/components/ui/*.tsx",
      "default": "./src/components/ui/*.tsx"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./layouts/*": {
      "types": "./src/layouts/*.tsx",
      "default": "./src/layouts/*.tsx"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@inertiajs/react": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@simple-module-py/i18n": "0.0.11",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.0.0",
    "embla-carousel-react": "^8.0.0",
    "input-otp": "^1.0.0",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.0",
    "radix-ui": "^1.4.0",
    "react-day-picker": "^9.0.0",
    "react-resizable-panels": "^4.0.0",
    "recharts": "^3.0.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "vaul": "^1.0.0"
  },
  "devDependencies": {
    "@simple-module-py/tsconfig": "0.0.11"
  }
}
